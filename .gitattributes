# Git hooks are shell scripts run by sh. With CRLF line endings sh fails with
# "bad interpreter: no such file or directory" -- installed, silent and dead.
# On Windows the default autocrlf would introduce exactly that on the next
# checkout, so force LF regardless of platform or user config.
reference/_build/hooks/* text eol=lf
*.sh text eol=lf

# navigator.html is generated by reference/_build/publish.ps1 from the markdown
# beside it. Collapse it in diffs and reviews; review the sources.
reference/navigator.html linguist-generated=true -diff

# The builder is python; keep it LF so core.autocrlf=true does not leave a
# phantom-modified file that `git diff` cannot explain.
reference/_build/*.py    text eol=lf
